using System.Collections.Generic;
using System.Numerics;

namespace Rastvordd.Sim
{
    /// <summary>Р’РІРѕРґ РѕРґРЅРѕРіРѕ С‚РёРєР°. РћРґРёРЅР°РєРѕРІС‹Р№ РґР»СЏ РёРіСЂРѕРєР° Рё Р±РѕС‚Р°: Р±РѕС‚С‹ СѓРїСЂР°РІР»СЏСЋС‚ РїРµСЂСЃРѕРЅР°Р¶РµРј С‚Р°Рє Р¶Рµ, РєР°Рє Р»СЋРґРё.</summary>
    public struct InputCmd
    {
        public Vector2 Move;      // РЅР°РїСЂР°РІР»РµРЅРёРµ РІ РїР»РѕСЃРєРѕСЃС‚Рё XZ, РґР»РёРЅР° РґРѕ 1
        public Vector2 Aim;       // С‚РѕС‡РєР° РїСЂРёС†РµР»Р° РІ РјРёСЂРµ
        public bool Fire;         // Р·Р°Р¶Р°С‚Р° Р»Рё Р›РљРњ (СЃС‚СЂРµР»СЊР±Р° / СѓРґР°СЂ / СѓСЃС‚Р°РЅРѕРІРєР°)
        public bool Sprint;
        public bool Reload;       // СЂР°Р·РѕРІС‹Рµ РЅР°Р¶Р°С‚РёСЏ (РґРµР№СЃС‚РІСѓСЋС‚ РѕРґРёРЅ С‚РёРє)
        public bool Interact;
        public bool Heal;
        public bool Eat;
        public bool Respawn;
        public bool DebugKit;
        public float Peek;        // 0..1: РЅР°СЃРєРѕР»СЊРєРѕ РёРіСЂРѕРє РїСЂРёС†РµР»РёРІР°РµС‚СЃСЏ (РџРљРњ)
        public int SelectSlot;    // -1 вЂ” Р±РµР· СЃРјРµРЅС‹ СЃР»РѕС‚Р° РїРѕСЏСЃР°
        public int Craft;         // РёРЅРґРµРєСЃ СЂРµС†РµРїС‚Р°, -1 вЂ” РЅРёС‡РµРіРѕ

        public static InputCmd Empty => new InputCmd { SelectSlot = -1, Craft = -1 };
    }

    public enum NodeKind { Tree, Stone, Metal, Sulfur }

    public sealed class WeaponDef
    {
        public string Id;
        public string AmmoId;
        public float Damage;
        public float FireInterval;
        public int Magazine;
        public float ReloadTime;
        public float BaseSpreadDeg;
        public float BloomPerShotDeg;
        public float MaxBloomDeg;
        public float BloomRecoverDeg;   // РіСЂР°РґСѓСЃРѕРІ РІ СЃРµРєСѓРЅРґСѓ
        public float BulletSpeed;
        public float Range;
        public bool Auto;
        public float NoiseRadius;

        // Р±Р»РёР¶РЅРёР№ Р±РѕР№ Рё РґРѕР±С‹С‡Р°
        public bool Melee;
        public float MeleeArcDeg = 90;
        public float GatherTree, GatherStone, GatherMetal, GatherSulfur;

        public float Gather(NodeKind k) => k switch
        {
            NodeKind.Tree => GatherTree,
            NodeKind.Stone => GatherStone,
            NodeKind.Metal => GatherMetal,
            _ => GatherSulfur,
        };

        public static WeaponDef MeleeTool(string id, float dmg, float interval, float range, float tree, float stone, float metal, float sulfur, float arc = 90) => new WeaponDef
        {
            Id = id, Melee = true, Damage = dmg, FireInterval = interval, Range = range, MeleeArcDeg = arc,
            GatherTree = tree, GatherStone = stone, GatherMetal = metal, GatherSulfur = sulfur, NoiseRadius = 12,
        };
    }

    public sealed class WeaponState
    {
        public WeaponDef Def;
        public int Ammo;
        public float Cooldown;
        public float Bloom;
        public float ReloadLeft;   // > 0 вЂ” РёРґС‘С‚ РїРµСЂРµР·Р°СЂСЏРґРєР°
        public WeaponState(WeaponDef def, int ammo) { Def = def; Ammo = ammo; }
    }

    public enum ItemCategory { Resource, Component, Tool, Weapon, Ammo, Food, Medical, Deployable }
    public enum DeployKind { None, Workbench, Furnace }

    public sealed class ItemDef
    {
        public string Id;
        public string Name;
        public ItemCategory Category;
        public WeaponDef Weapon;
        public float Food, Water, Heal;
        public DeployKind Deploy;

        /// <summary>РџСЂРµРґРјРµС‚С‹, РєРѕС‚РѕСЂС‹Рµ РґРµСЂР¶Р°С‚ РІ СЂСѓРєР°С…, Р¶РёРІСѓС‚ РЅР° РїРѕСЏСЃРµ (РїРѕ РѕРґРЅРѕРјСѓ РІ СЃР»РѕС‚Рµ).</summary>
        public bool Holdable => Weapon != null || Deploy != DeployKind.None;
    }

    /// <summary>РџСЂРµРґРјРµС‚ РІ СЃР»РѕС‚Рµ РїРѕСЏСЃР° РёР»Рё РІ РєРѕРЅС‚РµР№РЅРµСЂРµ. РЈ РѕСЂСѓР¶РёСЏ вЂ” СЃРІРѕС‘ СЃРѕСЃС‚РѕСЏРЅРёРµ (РїР°С‚СЂРѕРЅС‹ РІ РјР°РіР°Р·РёРЅРµ).</summary>
    public sealed class ItemSlot
    {
        public string Id;
        public int Count;
        public WeaponState State;
        public ItemSlot(string id, int count, WeaponState state = null) { Id = id; Count = count; State = state; }
        public ItemDef Def => Items.Get(Id);
    }

