            Add("canned", "РљРѕРЅСЃРµСЂРІС‹", ItemCategory.Food).Food = 35;
            Add("water_bottle", "Р‘СѓС‚С‹Р»РєР° РІРѕРґС‹", ItemCategory.Food).Water = 35;
            Add("bandage", "Р‘РёРЅС‚", ItemCategory.Medical).Heal = 25;

            // РёРЅСЃС‚СЂСѓРјРµРЅС‚С‹: СѓСЂРѕРЅ, РёРЅС‚РµСЂРІР°Р», РґР°Р»СЊРЅРѕСЃС‚СЊ, РґРѕР±С‹С‡Р° РґРµСЂРµРІРѕ/РєР°РјРµРЅСЊ/РјРµС‚Р°Р»Р»/СЃРµСЂР°
            Add("tool_rock", "Р‘СѓР»С‹Р¶РЅРёРє", ItemCategory.Tool).Weapon = WeaponDef.MeleeTool("tool_rock", 8, 0.7f, 1.7f, 6, 6, 4, 4);
            Add("tool_hatchet", "РљР°РјРµРЅРЅС‹Р№ С‚РѕРїРѕСЂ", ItemCategory.Tool).Weapon = WeaponDef.MeleeTool("tool_hatchet", 15, 0.8f, 1.8f, 16, 3, 2, 2);
            Add("tool_pickaxe", "РљР°РјРµРЅРЅР°СЏ РєРёСЂРєР°", ItemCategory.Tool).Weapon = WeaponDef.MeleeTool("tool_pickaxe", 14, 0.9f, 1.8f, 3, 14, 10, 9);
            Add("weapon_spear", "Р”РµСЂРµРІСЏРЅРЅРѕРµ РєРѕРїСЊС‘", ItemCategory.Weapon).Weapon = WeaponDef.MeleeTool("weapon_spear", 35, 0.9f, 2.3f, 1, 1, 1, 1, 50);

            // РѕРіРЅРµСЃС‚СЂРµР» Рё Р»СѓРє
            Add("weapon_bow", "Р›СѓРє", ItemCategory.Weapon).Weapon = new WeaponDef
