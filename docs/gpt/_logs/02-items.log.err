        }

        public static ItemDef Get(string id) => Defs.TryGetValue(id, out var d) ? d : null;
        public static string Name(string id) => Defs.TryGetValue(id, out var d) ? d.Name : id;

        /// <summary>РќРѕРІС‹Р№ РїСЂРµРґРјРµС‚ РґР»СЏ РїРѕСЏСЃР°: Сѓ РѕСЂСѓР¶РёСЏ СЃСЂР°Р·Сѓ Р·Р°РІРѕРґРёС‚СЃСЏ СЃРѕСЃС‚РѕСЏРЅРёРµ.</summary>
        public static ItemSlot NewSlot(string id, int ammo = 0)
        {
            var def = Get(id);
            return new ItemSlot(id, 1, def?.Weapon != null ? new WeaponState(def.Weapon, ammo) : null);
        }
    }

