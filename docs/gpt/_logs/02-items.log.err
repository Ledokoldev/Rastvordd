            Add("scrap", "РњРµС‚Р°Р»Р»РѕР»РѕРј", ItemCategory.Component);

            // РїР°С‚СЂРѕРЅС‹
            Add("ammo_pistol", "РџР°С‚СЂРѕРЅС‹ (РїРёСЃС‚.)", ItemCategory.Ammo);
            Add("ammo_rifle", "РџР°С‚СЂРѕРЅС‹ 5.56", ItemCategory.Ammo);
