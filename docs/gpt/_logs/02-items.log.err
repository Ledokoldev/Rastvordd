"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
$ErrorActionPreference = '"'Stop'
"'$itemText = Get-Content -Encoding UTF8 -Raw docs/gpt/02-items.md
$tableMatches = [regex]::Matches($itemText, '"'(?m)(?:"'^'"\\|.*\\r?\\n)+')
foreach ("'$itemTable in $tableMatches) {
    $columnCounts = @($itemTable.Value.Trim() -split '"'\\r?\\n' | ForEach-Object { ("'$_ -split '"'\\|').Count } | Select-Object -Unique)
    if ("'$columnCounts.Count -ne 1) { throw '"'Unequal Markdown table widths' }
}
"'$gearRows = @($itemText -split '"'\\r?\\n' | Where-Object { "'$_ -match '"'"'^'"\\|.*"'`gear_'"' })
if ("'$gearRows.Count -ne 25) { throw '"'Expected 25 armor rows' }
"'$expectedTotals = @(@(4,55,0),@(20,50,0),@(30,25,8),@(45,15,13),@(8,90,3))
for ($setIndex=0; $setIndex -lt 5; $setIndex++) {
    $gearTotals = @(0,0,0)
    for ($partIndex=0; $partIndex -lt 5; $partIndex++) {
        $gearCells = $gearRows[$setIndex*5+$partIndex] -split '"'\\|'
        for ("'$paramIndex=0; $paramIndex -lt 3; $paramIndex++) { $gearTotals[$paramIndex] += [int]$gearCells[$paramIndex+3].Trim() }
    }
    if (($gearTotals -join '"',') -ne ("'$expectedTotals[$setIndex] -join '"',')) { throw 'Armor sum mismatch' }
}
"'$wallHp = @(10,250,500,1000,2000)
$raidDmg = @(@(10,60,0,0,0),@(10,35,5,2,1),@(10,125,50,40,40),@(10,250,275,275,275),@(10,150,130,130,130),@(10,4,2,2,1))
$raidCounts = @(@(1,5,0,0,0),@(1,8,100,500,2000),@(1,2,10,25,50),@(1,1,2,4,8),@(1,2,4,8,16),@(1,63,250,500,2000))
for ($raidIndex=0; $raidIndex -lt 6; $raidIndex++) {
    for ($wallIndex=0; $wallIndex -lt 5; $wallIndex++) {
        $chargeCount=0
        if ($raidDmg[$raidIndex][$wallIndex] -gt 0) { $chargeCount=[math]::Ceiling($wallHp[$wallIndex]/$raidDmg[$raidIndex][$wallIndex]) }
        if ($chargeCount -ne $raidCounts[$raidIndex][$wallIndex]) { throw '"'Raid count mismatch' }
    }
}
if ("'$itemText.Contains([char]0xFFFD)) { throw '"'Invalid UTF-8 replacement character' }
Write-Output ('Проверено: {0} таблиц; 25 вещей; суммы защиты и 30 расчётов расхода на стены совпадают.' -f "'$tableMatches.Count)
